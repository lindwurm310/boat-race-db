{
  "manifest_version": 3,
  "name": "ボートレース予想",
  "version": "1.4.1",
  "description": "ボートレース予想の操作画面を開くボタンと、boatrace.jp のレースのページにおすすめの買い目を出すパネル。テレボートの投票画面では今日の単勝買い目をベットリストに入れる。",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "ボートレース予想の操作画面を開く",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://lindwurm310.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.boatrace.jp/*",
        "https://boatrace.jp/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ]
    },
    {
      "matches": [
        "https://ib.mbrace.or.jp/tohyo-ap-pctohyo-web/*"
      ],
      "js": [
        "teleboat.js"
      ],
      "css": [
        "panel.css"
      ]
    },
    {
      "matches": [
        "https://ib.mbrace.or.jp/*"
      ],
      "js": [
        "login.js"
      ],
      "all_frames": false,
      "css": [
        "panel.css"
      ]
    }
  ],
  "permissions": [
    "storage"
  ]
}
